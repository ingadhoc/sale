<odoo>
    <!-- Entry point of the payment options report. It calls the standard wrapper, which is where
         the localizations route the document to their own version of it, instead of rendering the
         document itself: rendering it here would print the generic quotation in every country. -->
    <template id="report_saleorder_payment_options">
        <t t-set="docs" t-value="docs.with_context(print_payment_options=True)"/>
        <t t-call="sale.report_saleorder_raw"/>
    </template>

    <template id="report_saleorder_payment_options_document" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='display_taxes']" position="after">
            <t t-set="print_payment_options" t-value="doc.env.context.get('print_payment_options') and doc.payment_option_ids"/>
            <t t-set="payment_options_by_line" t-value="print_payment_options and doc.company_id.sale_payment_options_by_line"/>
        </xpath>
        <!-- Per line options are computed on the line amount taxes included, so the line has to
             print that amount and not its net subtotal, or the installments tie to no printed figure. -->
        <xpath expr="//t[@t-set='price_field']" position="after">
            <t t-if="payment_options_by_line" t-set="price_field" t-value="'price_total'"/>
        </xpath>
        <xpath expr="//tr[@name='tr_product']" position="after">
            <t t-if="payment_options_by_line and not is_section and not is_subsection and not is_note and not is_combo and not line.is_downpayment">
                <t t-set="installments_display" t-value="line._get_payment_options_installments_display()"/>
                <tr t-if="installments_display" name="tr_payment_options_installments" class="fst-italic o_line_note">
                    <td name="td_payment_options_installments" colspan="99" t-att-class="padding_class">
                        <span t-out="installments_display"/>
                    </td>
                </tr>
            </t>
        </xpath>
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <t t-if="print_payment_options and not payment_options_by_line">
                <h3>Payment Options</h3>
                <div>
                    <table class="o_has_total_table table o_main_table table-borderless">
                        <thead style="display: table-row-group">
                            <tr>
                                <th class="text-start">Op.</th>
                                <th class="text-start">% OV</th>
                                <th class="text-end">Installment plan</th>
                                <th class="text-end">Surcharge</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">Total per installment</th>
                                <th class="text-end">Installment quantity</th>
                            </tr>
                        </thead>
                        <t t-foreach="doc.payment_option_ids._grouped_by_option()" t-as="opt">
                            <t>
                                <tr>
                                    <td colspan="7" style="border-top:1px solid #111827"></td>
                                </tr>
                            </t>
                            <tbody>
                                <t t-foreach="opt" t-as="row">
                                    <tr>
                                        <td class="text-start" t-if="row_index == 0" t-att-rowspan="len(opt)"><t t-out="opt[0].option_number"/></td>
                                        <td class="text-start" t-if="row_index != 0" style="display:none"></td> <!-- The following hidden cell is used to keep table alignment when using rowspan for the index column. -->
                                        <td class="text-start"><t t-out="row.percentage * 100"/>%</td>
                                        <!-- The plan name is free text: without breaking it, a long one widens this
                                             column past the right margin. Dropping text-nowrap alone is not enough. -->
                                        <td class="text-end" style="word-break: break-word; overflow-wrap: anywhere;"><t t-out="row.card_installment_id.display_name"/></td>
                                        <td class="text-end"><t t-out="row.surcharge"/>%</td>
                                        <td class="text-end"><span t-out="row.amount_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                        <td class="text-end"><span t-out="row.amount_per_installment" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                        <td class="text-end"><t t-out="row.installment_qty"/></td>
                                    </tr>
                                </t>
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-end">Total</td>
                                    <td class="text-end"><span t-out="sum(opt.mapped('amount_subtotal'))" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </t>
                    </table>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
