<odoo>
    <record id="view_order_form_inherit_payment_options" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.payment.options</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Payment Options" groups="base.group_user">
                    <group>
                        <field name="payment_option_template_id" readonly="state == 'sale'"/>
                    </group>
                    <field name="payment_option_ids" readonly="state == 'sale'">
                        <list editable="bottom" decoration-danger="option_percentage_invalid">
                            <field name="sequence" widget="handle"/>
                            <field name="option_number"/>
                            <field name="card_installment_id"/>
                            <field name="percentage" widget="percentage"/>
                            <field name="surcharge"/>
                            <field name="installment_qty"/>
                            <!-- No column sum: the options are alternatives to each other, so adding up their subtotals means nothing. -->
                            <field name="amount_subtotal"/>
                            <field name="amount_per_installment"/>
                            <field name="option_percentage_total" widget="percentage" optional="hide"/>
                            <field name="option_percentage_invalid" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
