<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="invoicing_setting_container" position="after">
                <block title="Barcode Operations" name="barcode_setting_container">
                    <setting id="barcode_scanner_setting"
                             string="Barcode Scanner"
                             help="Process operations faster with barcodes">
                        <div class="content-group">
                            <div class="mt16">
                                <a href="/sale_barcode/static/img/barcodes_actions.pdf" class="fw-bold" target="_blank">
                                    <i class="fa fa-download"/> Print Sales Barcode Commands
                                </a>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
