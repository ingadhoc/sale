<odoo>
    <record id="sot_sale_order_type_form_view" model="ir.ui.view">
        <field name="name">sale.order.type.form.view</field>
        <field name="model">sale.order.type</field>
        <field name="inherit_id" ref="sale_order_type_invoice_policy.sot_sale_order_type_form_view"/>
        <field name="arch" type="xml">
            <field name="invoice_policy" position="after">
                <field name="services_delivered" invisible="invoice_policy != 'delivery'"/>
            </field>
        </field>
    </record>
</odoo>
