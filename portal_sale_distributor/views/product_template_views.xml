<odoo>
     <record model="ir.ui.view" id="product_template_view_form">
        <field name="name">view.prod.form.inh.l10n.pe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <header position="attributes">
                <attribute name="groups">!portal_sale_distributor.group_portal_backend_distributor</attribute>
            </header>
            <chatter position="attributes">
                <attribute name="groups">!portal_sale_distributor.group_portal_backend_distributor</attribute>
            </chatter>
            <sheet position="attributes">
                <attribute name="groups">!portal_sale_distributor.group_portal_backend_distributor</attribute>
            </sheet>
            <sheet position="after">
                <sheet groups="portal_sale_distributor.group_portal_backend_distributor">
                    <div class="oe_title">
                        <label for="name" string="Product"/>
                        <h1>
                            <div class="d-flex">
                                <field class="text-break" name="name" options="{'line_breaks': False}" widget="text" placeholder="e.g. Cheese Burger"/>
                            </div>
                        </h1>
                    </div>
                </sheet>
            </sheet>
        </field>
    </record>
</odoo>
