<?xml version="1.0" encoding="utf-8"?>
<!-- Not noupdate: this domain is meant to be tightened further. -->
<odoo>

    <!-- Adds only what base.res_partner_portal_public_rule leaves out. Every term here is
         readable across the database: widen it only against a reproduced access error. -->
    <record id="portal_res_partner_distributor_rule" model="ir.rule">
        <field name="name">res.partner: read access for distributor</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id', 'in', user.company_ids.partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
    </record>

</odoo>
