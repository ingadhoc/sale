<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record model="res.groups.privilege" id="privilege_portal_sale_distributor">
        <field name="name">Portal Sale Distributor</field>
        <field name="description">Advanced sale distributor permissions</field>
        <field name="category_id" ref="portal_backend.category_portal_advanced"/>
        <field name="sequence" eval="10"/>
    </record>

    <record model="res.groups" id="group_portal_backend_distributor">
        <field name="name">Portal Sale Distributor</field>
        <field name="privilege_id" ref="privilege_portal_sale_distributor"/>
        <field name="implied_ids" eval="[Command.link(ref('portal_backend.group_portal_backend'))]"/>
    </record>

    <record model="res.groups" id="group_portal_backend_distributor_stock">
        <field name="name">Portal Sale Distributor - Stock</field>
        <field name="privilege_id" ref="privilege_portal_sale_distributor"/>
        <field name="implied_ids" eval="[Command.link(ref('group_portal_backend_distributor'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4,ref('sale.group_discount_per_so_line'))]"/>
    </record>

    <!-- Sale Portal Distributor CRUD all orders -->
    <record id="portal_sale_order_user_rule" model="ir.rule">
        <field name="name">Portal Distributor same partner Quotations/Sales Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('partner_id','child_of',[user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_unlink"/>
        <field eval="1" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="1" name="perm_create"/>
    </record>

    <!-- Sale Portal Distributor CRUD all orders -->
    <record id="portal_sale_order_line_user_rule" model="ir.rule">
        <field name="name">Portal Distributor same partner Quotations/Sales Orders</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.partner_id','child_of',[user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_unlink"/>
        <field eval="1" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="1" name="perm_create"/>
    </record>

    <record id="portal_product_template_public_rule" model="ir.rule">
        <field name="name">Public product template (distribuidores) </field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">[(1 ,'=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
    </record>

    <!-- mrp_subcontracting limits warehouses to the partner's own pickings for
         base.group_portal; a distributor has none and could not add order lines.
         Same reason as the product.template rule above. -->
    <record id="portal_stock_warehouse_rule" model="ir.rule">
        <field name="name">Warehouses (distribuidores)</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
    </record>

    <!-- Same reason as the two rules above, for the rest of the stock models
         mrp_subcontracting restricts on base.group_portal. The domain is scoped to
         the companies of the user, on top of the global multi-company rule of stock.
         stock.picking is left out: the portal rule on transfers already covers the
         orders of the partner. -->
    <record id="portal_stock_location_rule" model="ir.rule">
        <field name="name">Ubicaciones (distribuidores)</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
    </record>

    <record id="portal_stock_picking_type_rule" model="ir.rule">
        <field name="name">Tipos de operación (distribuidores)</field>
        <field name="model_id" ref="stock.model_stock_picking_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
    </record>

    <record id="portal_stock_move_rule" model="ir.rule">
        <field name="name">Movimientos de stock (distribuidores)</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
    </record>

    <record id="portal_stock_move_line_rule" model="ir.rule">
        <field name="name">Movimientos detallados (distribuidores)</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_portal_backend_distributor'))]"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
    </record>

</odoo>
