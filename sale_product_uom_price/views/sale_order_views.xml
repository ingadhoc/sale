<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.product.uom.price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="after">
                <field name="price_unit_product_uom_editable" column_invisible="1"/>
                <field name="price_unit_product_uom"
                       optional="hide"
                       readonly="not price_unit_product_uom_editable"/>
            </xpath>
        </field>
    </record>
</odoo>
