msgid "Coef"
msgstr "Coef"

#. module: sale_gathering_index
#: model:ir.model.fields,help:sale_gathering_index.field_sale_order__coef
msgid ""
"Coeficiente inverso que se utiliza para estimar el precio de un producto "
"canjeado a la fecha de confirmación del acopio. Para calcular el precio se "
"toma el precio actual del producto y se lo divide por este coeficiente."
msgstr ""
"Coeficiente inverso que se utiliza para estimar el precio de un producto "
"canjeado a la fecha de confirmación del acopio. Para calcular el precio se "
"toma el precio actual del producto y se lo divide por este coeficiente."

