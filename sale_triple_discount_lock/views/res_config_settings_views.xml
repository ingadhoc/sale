<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.sale.triple.discount.ux</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting
                    string="Lock Discount 1"
                    help="Discount 1 is readonly and set by pricelist rules. Discount 2 and 3 are editable and preserved when updating prices or quantities."
                >
                    <field name="lock_discount1_readonly"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
