<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_saleorder" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t t-set="show_images" t-value="doc.env['ir.config_parameter'].sudo().get_param('sale_ux.show_product_image_on_report')"/>
            <t t-set="product_image_size" t-value="doc.env['ir.config_parameter'].sudo().get_param('sale_ux.product_image_size', '128_50')"/>
            <t t-set="display_size" t-value="int(product_image_size.split('_')[1])"/>
            <t t-set="column_width" t-value="display_size + 10"/>
        </xpath>
        <th name="th_description" position="before">
            <th t-if="show_images" name="th_image" class="text-center" t-attf-style="width: {{column_width}}px;">Image</th>
        </th>
        <td name="td_product_name" position="before">
            <td t-if="show_images" name="td_image" class="text-center" t-attf-style="width: {{column_width}}px;">
                <img t-if="line.product_id.image_sale_order"
                     t-att-src="image_data_uri(line.product_id.image_sale_order)"
                     t-attf-style="display: block; margin: auto; width: auto; height: auto; max-width: {{display_size}}px; max-height: {{display_size}}px; object-fit: contain;"
                     alt="Product image"/>
            </td>
        </td>
        <!-- Lines sold in another unit (e.g. a packaging) shown in the product unit -->
        <td name="td_product_quantity" position="before">
            <t t-set="uom_vals" t-value="line._get_report_product_uom_values()"/>
        </td>
        <xpath expr="//td[@name='td_product_quantity']/span[@t-field='line.product_uom_qty']" position="attributes">
            <attribute name="t-if">not uom_vals</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']/span[@t-field='line.product_uom_id']" position="attributes">
            <attribute name="t-if">not uom_vals</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']/span[hasclass('text-muted')]" position="attributes">
            <attribute name="t-if" add="not uom_vals" separator=" and "/>
        </xpath>
        <td name="td_product_quantity" position="inside">
            <t t-if="uom_vals">
                <span t-out="uom_vals['qty']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}" class="text-nowrap"/>
                <span t-out="uom_vals['uom'].name"/>
                <span class="text-muted small">
                    <br/><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom_id"/>
                </span>
            </t>
        </td>
        <!-- By attribute and not by position: another module can add a span to this cell -->
        <xpath expr="//td[@name='td_product_priceunit']/span[@t-out]" position="attributes">
            <attribute name="t-if" add="not uom_vals" separator=" and "/>
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']/span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-elif" add="not uom_vals" separator=" and "/>
        </xpath>
        <td name="td_product_priceunit" position="inside">
            <span
                t-if="uom_vals and not collapse_prices"
                t-out="(1 - line.discount / 100.0) * uom_vals['price_unit'] if line.discount &lt; 0 else uom_vals['price_unit']"
                t-options="uom_vals['price_options']"
            />
        </td>
        <!-- Empty image-column cell so non-product rows keep the grid aligned -->
        <td name="td_section_name" position="before">
            <td t-if="show_images" name="td_section_image" t-attf-style="width: {{column_width}}px;"/>
        </td>
        <td name="td_combo_name" position="before">
            <td t-if="show_images" name="td_combo_image" t-attf-style="width: {{column_width}}px;"/>
        </td>
        <td name="td_section_group_name" position="before">
            <td t-if="show_images" name="td_section_group_image" t-attf-style="width: {{column_width}}px;"/>
        </td>
    </template>
</odoo>
