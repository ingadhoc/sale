<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_line_lost_reason_view_tree" model="ir.ui.view">
        <field name="name">sale.order.line.lost.reason.list</field>
        <field name="model">sale.order.line.lost.reason</field>
        <field name="arch" type="xml">
            <list string="Unsold Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="sale_order_line_lost_reason_view_form" model="ir.ui.view">
        <field name="name">sale.order.line.lost.reason.form</field>
        <field name="model">sale.order.line.lost.reason</field>
        <field name="arch" type="xml">
            <form string="Unsold Reason">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_order_line_lost_reason_view_search" model="ir.ui.view">
        <field name="name">sale.order.line.lost.reason.search</field>
        <field name="model">sale.order.line.lost.reason</field>
        <field name="arch" type="xml">
            <search string="Unsold Reasons">
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sale_order_line_lost_reason" model="ir.actions.act_window">
        <field name="name">Unsold Reasons</field>
        <field name="res_model">sale.order.line.lost.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new unsold reason</p>
            <p>Record why a quoted quantity was not sold: price, out of stock, the customer changed their mind.</p>
        </field>
    </record>

    <menuitem id="menu_sale_order_line_lost_reason"
        action="action_sale_order_line_lost_reason"
        parent="sale.menu_sale_config"
        groups="sale_ux.group_lost_qty"
        sequence="25"/>

</odoo>
