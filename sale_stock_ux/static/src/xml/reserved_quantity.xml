<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <div t-extend="sale_stock.QtyDetailPopOver">
        <t t-jquery="t[t-if*='!data.is_mto']" t-operation="append">
            <tr>
                <td>
                    <strong>Reservado</strong>
                </td>
                <td>
                    <t t-out='this.data.total_reserved_quantity' />
