<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <t t-name="sale_stock_ux.QtyAtDatePopover" t-inherit="sale_stock.QtyAtDatePopover" t-inherit-mode="extension">

        <xpath expr="//table[contains(@class,'table-sm')]" position="after">
            <t t-if="props.record.data.stock_by_location">
                <hr class="my-1"/>
                <table class="table table-borderless table-sm">
                    <tr>
                        <th class="text-start">Stock by Location</th>
                        <th class="text-end">Quantity</th>
                    </tr>
                    <t t-foreach="props.record.data.stock_by_location.split('\n')" t-as="line" t-key="line_index">
                        <tr t-if="line.includes(':')">
                            <td class="text-start">
                                <span t-out="line.split(':')[0]"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-out="line.split(':')[1]"/>
                            </td>
                        </tr>
                    </t>
                </table>
            </t>
        </xpath>

    </t>

</templates>
