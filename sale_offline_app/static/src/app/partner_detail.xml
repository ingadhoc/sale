<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sale_offline_app.PartnerDetail">
        <div class="p-3">
            <dl class="row mb-3">
                <t t-foreach="rows" t-as="row" t-key="row[0]">
                    <dt class="col-5 text-muted fw-normal" t-esc="row[0]"/>
                    <dd class="col-7" t-esc="row[1]"/>
                </t>
            </dl>
            <a t-if="mapsUrl" t-att-href="mapsUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-lg w-100">
                <i class="fa fa-map-marker me-2"/>Abrir en Google Maps
            </a>
            <div t-else="" class="text-muted">El cliente no tiene ubicación cargada.</div>
        </div>
    </t>
</templates>
