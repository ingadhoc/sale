<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sale_offline_app.ActivitiesScreen">
        <div t-if="!days.length" class="p-4 text-center text-muted">
            No tenés visitas pendientes. Sincronizá desde Configuración para bajar las visitas.
        </div>
        <t t-else="">
            <div class="o_preventa_search p-2 border-bottom">
                <input type="search" class="form-control form-control-lg" placeholder="Buscar cliente: código, CUIT o nombre"
                    t-model="state.query" autocomplete="off"/>
                <div t-if="!state.query" class="o_preventa_days d-flex gap-2 mt-2">
                    <button t-foreach="days" t-as="day" t-key="day.key" type="button"
                        t-attf-class="btn btn-sm rounded-pill text-nowrap {{ day.key === selectedDay ? 'btn-primary' : (day.key === 'overdue' ? 'btn-outline-danger' : 'btn-outline-secondary') }}"
                        t-on-click="() => this.data.workDay = day.key" t-esc="day.label"/>
                </div>
            </div>
            <div class="px-3 pt-2 pb-1 small text-muted">
                <t t-if="state.query">Visitas de todos los días bajados que coinciden (<t t-esc="items.length"/>)</t>
                <t t-else=""><t t-esc="doneCount"/> de <t t-esc="items.length"/> visitadas</t>
            </div>
            <div class="list-group list-group-flush">
                <div t-foreach="items" t-as="item" t-key="item.activity.id"
                    class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-3">
                    <div class="flex-grow-1 min-w-0" role="button" t-att-aria-disabled="!item.partner"
                        t-on-click="() => item.partner and props.onStart(item.activity)">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <span class="fw-bold text-primary" t-esc="title(item)"/>
                            <t t-set="itemBadge" t-value="badge(item.order)"/>
                            <span t-if="itemBadge" t-attf-class="badge text-nowrap {{ itemBadge.cls }}">
                                <i t-attf-class="fa {{ itemBadge.icon }} me-1"/><t t-esc="itemBadge.label"/>
                            </span>
                        </div>
                        <small class="d-block text-muted" t-esc="subtitle(item)"/>
                        <small t-if="item.activity.note" class="d-block text-muted fst-italic" t-esc="item.activity.note"/>
                    </div>
                    <t t-set="itemMapsUrl" t-value="mapsUrl(item.partner)"/>
                    <a t-if="itemMapsUrl" t-att-href="itemMapsUrl" target="_blank" rel="noopener"
                        class="btn btn-outline-primary flex-shrink-0 o_preventa_map_btn" title="Abrir en Google Maps">
                        <i class="fa fa-map-marker fa-lg"/>
                    </a>
                </div>
            </div>
        </t>
    </t>
</templates>
