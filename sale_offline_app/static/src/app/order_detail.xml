<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sale_offline_app.OrderDetail">
        <div class="p-3 border-bottom small">
            <div class="fs-6 fw-bold mb-1" t-esc="stateLabel"/>
            <t t-if="props.fromHistory">
                <div>Fecha: <t t-esc="formatDate(order.date_order)"/></div>
            </t>
            <t t-else="">
                <div>Cargado: <t t-esc="formatDate(order.date)"/></div>
                <div t-if="order.closed_at">Cerrado: <t t-esc="formatDate(order.closed_at)"/></div>
                <div t-if="order.sent_at">Enviado: <t t-esc="formatDate(order.sent_at)"/></div>
                <div t-if="order.reason">Motivo de no compra: <t t-esc="order.reason"/></div>
                <div t-if="order.reject_reason" class="text-danger">Motivo del rechazo: <t t-esc="order.reject_reason"/></div>
                <a t-if="mapsUrl" t-att-href="mapsUrl" target="_blank" rel="noopener">
                    <i class="fa fa-map-marker me-1"/>Dónde se cerró
                </a>
                <div t-else="" class="text-muted">Sin ubicación</div>
            </t>
        </div>
        <ul t-if="order.lines.length" class="list-group list-group-flush">
            <li t-foreach="order.lines" t-as="line" t-key="line.product_id" class="list-group-item d-flex justify-content-between">
                <div class="me-2">
                    <div t-esc="line.name"/>
                    <small class="text-muted">
                        <t t-esc="line.quantity"/> × <t t-esc="preventa.formatAmount(line.price_unit)"/> s/imp.
                        <t t-if="line.discount"> · desc. <t t-esc="line.discount"/>%</t>
                    </small>
                </div>
                <div t-if="!props.fromHistory" class="text-end text-nowrap fw-bold" t-esc="preventa.formatAmount(lineTotal(line))"/>
            </li>
        </ul>
        <div t-if="!isNoPurchase" class="p-3 border-top">
            <t t-if="!props.fromHistory">
                <div class="d-flex justify-content-between text-muted">
                    <span>Subtotal sin impuestos</span>
                    <span t-esc="preventa.formatAmount(order.amount_untaxed)"/>
                </div>
                <div class="d-flex justify-content-between text-muted">
                    <span>Impuestos</span>
                    <span t-esc="preventa.formatAmount(order.amount_tax)"/>
                </div>
            </t>
            <div class="d-flex justify-content-between fs-4 fw-bold">
                <span>Total</span>
                <span t-esc="preventa.formatAmount(order.amount_total)"/>
            </div>
            <button t-if="canRepeat" type="button" class="btn btn-outline-primary btn-lg w-100 mt-3"
                t-on-click="() => props.onRepeat(order)">
                <i class="fa fa-repeat me-2"/>Repetir pedido
            </button>
            <small t-if="canRepeat" class="d-block text-muted mt-1">Se copia al pedido en carga del cliente, con los precios de hoy.</small>
        </div>
    </t>
</templates>
