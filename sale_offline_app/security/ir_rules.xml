<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_offline_order_personal_rule" model="ir.rule">
        <field name="name">Offline orders: own</field>
        <field name="model_id" ref="model_sale_offline_order"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="sale_offline_order_see_all_rule" model="ir.rule">
        <field name="name">Offline orders: all</field>
        <field name="model_id" ref="model_sale_offline_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
    <record id="sale_offline_order_error_personal_rule" model="ir.rule">
        <field name="name">Offline order errors: own</field>
        <field name="model_id" ref="model_sale_offline_order_error"/>
        <field name="domain_force">[('offline_order_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="sale_offline_order_error_see_all_rule" model="ir.rule">
        <field name="name">Offline order errors: all</field>
        <field name="model_id" ref="model_sale_offline_order_error"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
</odoo>
