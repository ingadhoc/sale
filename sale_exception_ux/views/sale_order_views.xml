<?xml version="1.0" ?>
<odoo>
    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">sale_exceptions_ux.view_order_tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_exception.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="main_exception_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="name">sale_exceptions_ux.view_quotation_tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_exception.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="main_exception_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <record id="view_sale_exception_confirm_form" model="ir.ui.view">
        <field name="name">Sale Exceptions Inherit Form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_exception.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_ignore_exceptions']" position="attributes">
                <attribute name="groups">base_exception.group_exception_rule_manager,sales_team.group_sale_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
