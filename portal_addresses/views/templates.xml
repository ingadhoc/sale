<odoo>
    <template id="addresses" inherit_id="website_sale.checkout" primary="True">
        <t t-if="order._has_deliverable_products()" position="replace">
            <t t-call="portal_addresses.portal_delivery_address_row">
                <t t-set="addresses" t-value="delivery_addresses"/>
            </t>
         </t>
        <t t-call="website_sale.checkout_layout" position="attributes">
            <attribute name="t-call">portal_addresses.portal_checkout_layout</attribute>
        </t>
        <t t-call="website_sale.billing_address_list" position="attributes">
            <attribute name="t-call">portal_addresses.portal_billing_address_row</attribute>
        </t>
    </template>

    <template id="portal_checkout_layout" inherit_id="website_sale.checkout_layout" primary="True">
        <t t-call="website_sale.wizard_checkout" position="replace"/>
        <t t-call="website_sale.navigation_buttons" position="replace"/>
        <xpath expr="//t[@t-call='website_sale.shorter_cart_summary']" position="replace"></xpath>
        <t t-call="website_sale.navigation_buttons" position="replace"/>
    </template>

    <template id="portal_delivery_address_row" inherit_id="website_sale.delivery_address_list" primary="True">
        <t t-call="website_sale.address_list" position="attributes">
            <attribute name="t-call">portal_addresses.portal_address_row</attribute>
        </t>
    </template>

    <template id="portal_billing_address_row" inherit_id="website_sale.billing_address_list" primary="True">
        <t t-call="website_sale.address_list" position="attributes">
            <attribute name="t-call">portal_addresses.portal_address_row</attribute>
        </t>
    </template>

    <template id="portal_address_row" inherit_id="website_sale.address_list" primary="True">
        <t t-call="website_sale.address_card" position="replace">
            <t t-call="website_sale.address_card">
                <t t-set="is_user_address" t-value="address == request.env.user.partner_id"/>
                <t t-set="contact" t-value="address"/>
                <t t-set="can_be_edited" t-value="contact._can_be_edited_by_current_customer(order_sudo=order)"/>
                <t t-set="selected" t-value="address == selected_address"/>
                <t t-set="address_update_url" t-valuef="/portal/address/?partner_id={contact.id}"/>
            </t>
        </t>
    </template>

    <template id="portal_address" inherit_id="website_sale.address" primary="True">
        <t t-call="website_sale.checkout_layout" position="attributes">
            <attribute name="t-call">portal_addresses.portal_checkout_layout</attribute>
        </t>
        <form action="/shop/address/submit" position="attributes">
            <attribute name="action">/portal/address/submit</attribute>
        </form>
        <xpath expr="//form[@name='address_form']" position="inside">
            <t t-call="portal.address_footer">
                <t t-set="discard_url" t-value="'/portal/addresses'"/>
            </t>
        </xpath>
    </template>

</odoo>
